SECRET_KEY=your-default-secret-key
JWT_SECRET_KEY=your-secret-jwt-secret-key
DEBUG=false
LOG_LEVEL=INFO
# SMTP (example uses Mailtrap for testing)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=phishnet@company.com

# Base URL for tracking links embedded in phishing emails
APP_BASE_URL=http://localhost:5000
